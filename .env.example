# ---------------------------------------------------------------------------
# FRONTEND (Vite) — estas duas variáveis vão para o navegador.
# A chave anon é pública por design; o RLS é quem protege os dados.
# Copie este arquivo para .env.local e preencha.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publicavel

# ---------------------------------------------------------------------------
# EDGE FUNCTIONS (Supabase) — NUNCA entram no frontend.
# Configure com: supabase secrets set NOME=valor
# ---------------------------------------------------------------------------

# Senha do painel /admin. Gere com: openssl rand -hex 32
ADMIN_TOKEN=

# Provedor de LLM do bot de WhatsApp.
# O provedor e o modelo ativos são escolhidos no /admin; aqui ficam só as chaves.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# WhatsApp (uazapi) — recebe e envia mensagens
UAZAPI_URL=
UAZAPI_TOKEN=

# Número do dono, para receber avisos de lead qualificado (só dígitos, com DDI)
OWNER_WHATSAPP=5521995044848
